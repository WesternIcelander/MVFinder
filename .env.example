# Copy to .env and fill in. From https://developer.spotify.com/dashboard
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Optional: TIDAL API app from https://developer.tidal.com (without it, TIDAL's public pages are read)
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Optional (defaults shown)
# SPOTIFY_DAILY_REQUEST_BUDGET=250   # max Spotify API requests per 24h (Development Mode allows ~750/day in total)
# SPOTIFY_MAX_REQUESTS_PER_SECOND=3
# TIDAL_COUNTRY_CODE=US              # TIDAL API catalog country
# YTJS_VERSION=latest                # "latest", a major like "18", or an exact "18.3.0"
# YTJS_MIN_RELEASE_AGE_HOURS=24      # only adopt youtubei.js releases at least this old
# YTJS_UPDATE_INTERVAL_HOURS=6       # how often to check for updates and re-run the self-test
# YT_CONCURRENCY=4                   # parallel YouTube searches (across all requests)
# YT_LOCATION=US                     # YouTube region
# ISRC_FALLBACKS=deezer,musicbrainz  # where /isrc looks after Spotify; empty = Spotify only
# MUSICBRAINZ_USER_AGENT=isrc-lookup/1.0  # MusicBrainz asks for "AppName/version ( contact-url-or-email )"
# CACHE_TTL_HOURS=24                 # cache per-track matches
# CACHE_MAX_ENTRIES=20000
